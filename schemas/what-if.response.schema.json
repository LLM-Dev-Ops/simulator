{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://us-central1-agentics-dev.cloudfunctions.net/simulator-agents/schemas/what-if-response",
  "title": "What-If Simulation Agent Response",
  "description": "Response contract for the What-If Simulation Agent. Wraps a DecisionSignal with HypothesisPayload.",
  "type": "object",
  "required": ["signal", "execution_metadata", "layers_executed"],
  "properties": {
    "signal": {
      "type": "object",
      "required": ["signal_id", "signal_type", "timestamp_ms", "source_agent", "correlation_id", "payload", "latency_ms", "tokens_used"],
      "properties": {
        "signal_id": { "type": "string" },
        "signal_type": { "type": "string", "const": "hypothesis_signal" },
        "timestamp_ms": { "type": "integer" },
        "source_agent": { "type": "string", "const": "what-if" },
        "correlation_id": { "type": "string" },
        "payload": {
          "type": "object",
          "required": ["type", "data"],
          "properties": {
            "type": { "type": "string", "const": "Hypothesis" },
            "data": {
              "type": "object",
              "required": ["hypothesis", "confidence", "evidence", "alternatives", "reasoning"],
              "properties": {
                "hypothesis": { "type": "string" },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "evidence": { "type": "array", "items": { "type": "string" } },
                "alternatives": { "type": "array", "items": { "type": "string" } },
                "reasoning": { "type": "string" }
              }
            }
          }
        },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "tokens_used": { "type": "integer", "minimum": 0, "maximum": 2500 }
      }
    },
    "execution_metadata": { "$ref": "#/definitions/execution_metadata" },
    "layers_executed": { "$ref": "#/definitions/layers_executed" }
  },
  "definitions": {
    "execution_metadata": {
      "type": "object",
      "required": ["trace_id", "timestamp", "service", "execution_id"],
      "properties": {
        "trace_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "service": { "type": "string", "const": "simulator-agents" },
        "execution_id": { "type": "string" }
      }
    },
    "layers_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "status"],
        "properties": {
          "layer": { "type": "string" },
          "status": { "type": "string", "enum": ["completed", "failed"] },
          "duration_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
